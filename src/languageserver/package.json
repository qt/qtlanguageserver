{
    "dependencies": {
        "ts-node": "^10.9.2",
        "typescript": "^6.0.2"
    },
    "type": "module",
    "scripts": {
        "pregenerate":
                "tsc --downlevelIteration --strictNullChecks --ignoreDeprecations 6.0 --noImplicitAny false ./generate.ts ./3rdparty/metaModel.ts",
        "generate": "node ./generate.js",
        "postgenerate":
                "clang-format -i qlanguageservergen{_p.h,.cpp} qlanguageserverspec{,types}_p.h qlspnotifysignals{_p.h,.cpp}"
    }
}
